# Server Port
PORT=5223

# MongoDB Connection String
MONGODB_URI=mongodb://localhost:27017/chatSSE

# Authentication & Security
SECRET_KEY=change-this-to-a-secure-random-secret-key
JWT_EXPIRES_IN=30d
BCRYPT_ROUNDS=12
FRONTEND_URL=http://localhost:3000

# Optional Google OAuth Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# AI Model Endpoint (llama.cpp / OpenAI-compatible API)
AI_API_URL=https://myai.lmstream.xyz/v1

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_FORMAT=dev
LOG_DIR=../logs

# CORS & Cookies
ORIGIN=*
CREDENTIALS=true

# Redis Pub/Sub (Optional: set to false for in-memory fallback)
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379
REDIS_TTL=600
REDIS_PREFIX=chatSSE:
